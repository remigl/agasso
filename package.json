{
  "name": "agasso",
  "version": "0.1.0",
  "description": "Agasso Tennis Generation 2026 — tennis arcade sur terre battue à Roland-Garros",
  "author": "Rémi Gladieu",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "simulate": "node tools/simulate.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "be.remigl.agasso",
    "productName": "Agasso Tennis",
    "files": ["index.html", "src/**/*", "electron/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": { "artifactName": "AgassoTennis-portable.exe" },
    "nsis": { "artifactName": "AgassoTennis-setup.exe", "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
